{
  "framework": null,
  "installCommand": "echo no install",
  "buildCommand": "rm -rf dist && mkdir dist && cp -r index.html manifest.webmanifest sw.js css js icons dist/",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(js|css)/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
